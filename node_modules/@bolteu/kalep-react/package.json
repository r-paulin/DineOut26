{
  "name": "@bolteu/kalep-react",
  "version": "3.5.1",
  "description": "Kalep Design System React Library",
  "main": "build/index.js",
  "sideEffects": [
    "./build/*.css"
  ],
  "homepage": "https://github.com/bolteu/kalep/tree/main/packages/kalep-react",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bolteu/kalep.git"
  },
  "license": "UNLICENSED",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "build",
    "src",
    "tailwind.config.js"
  ],
  "devDependencies": {
    "@tanstack/react-form": "^1.28.3",
    "@types/react-datepicker": "^4.4.2",
    "autoprefixer": "^10.4.2",
    "axe-playwright": "^2.2.2",
    "babel-loader": "^8.2.5",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-define": "^2.1.0",
    "chromatic": "^13.3.2",
    "cssnano": "^6.0.1",
    "date-fns": "^2.29.3",
    "mixpanel-browser": "^2.56.0",
    "postcss-cli": "^8.3.1",
    "postcss-fail-on-warn": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwindcss": "^3.4.1",
    "tsc-alias": "^1.7.0"
  },
  "dependencies": {
    "@base-ui/react": "1.2.0",
    "@base-ui/utils": "^0.2.5",
    "@react-aria/overlays": "^3.20.0",
    "@react-aria/utils": "^3.23.0",
    "@sentry/react": "^10.30.0",
    "@szhsin/react-menu": "4.2.3",
    "@tanstack/react-virtual": "3.10.9",
    "clsx": "^2.1.1",
    "downshift": "8.2.3",
    "motion": "^11.18.1",
    "radix-ui": "^1.1.3",
    "react-aria": "^3.31.0",
    "react-datepicker": "6.9.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.5.5",
    "vaul": "^1.1.2",
    "@bolteu/kalep-tailwind": "3.2.0",
    "@bolteu/kalep-react-icons": "2.6.2"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">= 16.0.0",
    "pnpm": ">=8"
  },
  "browserslist": [
    "defaults"
  ],
  "scripts": {
    "prebuild": "pnpm clean",
    "clean": "rm -rf build/",
    "test": "vitest run --project kalep-react",
    "test:watch": "vitest --watch --project kalep-react",
    "test:cover": "vitest run --project kalep-react --coverage",
    "validate": "pnpm run test:cover & pnpm run lint & pnpm run build",
    "lint": "eslint 'src/**/*.{js,json,ts,tsx}'",
    "build-types": "tsc -p tsconfig.build.json --emitDeclarationOnly && tsc-alias -p tsconfig.build.json",
    "build-js": "babel src --out-dir build --extensions \".ts,.tsx\"",
    "build-css:scoped": "postcss ./src/tailwind.entrypoint.css -o ./build/kalep-scoped.css --config ./config/scoped",
    "build-css:versioned": "postcss ./src/tailwind.entrypoint.css -o ./build/kalep-versioned.css --config ./config/versioned",
    "build-css:default": "pnpm run build-css:scoped && cp ./build/kalep-scoped.css ./build/kalep.css",
    "build-css:plain": "postcss ./src/tailwind.entrypoint.css -o ./build/kalep-plain.css --config ./config/plain",
    "build:concurrently": "concurrently 'pnpm:build-*(!storybook)' -c 'red,green,blue,cyan,magenta' --timings --group",
    "build:watch": "onchange 'src/**/*' -- pnpm build:concurrently",
    "build": "pnpm run build:concurrently",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "pnpm -w exec test-storybook -c ./packages/kalep-react/.storybook",
    "precommit": "lint-staged",
    "watch:ts": "tsc --watch",
    "lint:module-type": "attw --pack ."
  }
}