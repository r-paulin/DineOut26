{
  "tabWidth": 4,
  "printWidth": 120,
  "singleQuote": false,
  "bracketSpacing": false,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.json",
      "options": {
        "tabWidth": 2
      }
    },
    {
      "files": ["*.mjs"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
