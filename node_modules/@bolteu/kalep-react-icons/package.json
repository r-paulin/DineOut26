{
  "name": "@bolteu/kalep-react-icons",
  "version": "2.6.2",
  "description": "Kalep icons as React components",
  "main": "dist/index.js",
  "sideEffects": false,
  "homepage": "https://github.com/bolteu/kalep/tree/main/packages/icons-react",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bolteu/kalep.git"
  },
  "license": "UNLICENSED",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "dist"
  ],
  "devDependencies": {
    "@svgr/cli": "^6.2.1",
    "@bolteu/kalep-icons-svg": "2.6.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "engines": {
    "node": ">= 16.0.0",
    "pnpm": ">=8"
  },
  "scripts": {
    "clean": "rm -rf dist/",
    "clean-src": "rm -f src/*.tsx",
    "prebuild": "pnpm clean",
    "build": "tsc --declaration",
    "generate-components": "pnpm clean-src && svgr --out-dir src --typescript -- ../icons/kalep-icons && eslint --fix src/ && prettier --write src/",
    "create-figma-connect": "node scripts/generate-figma-connect.js"
  }
}